{
  "name": "kitten-hill-mahjong",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kitten Hill Mahjong — four-player Chinese Classical mahjong, mobile-first, cats.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180",
    "build": "vite build",
    "preview": "vite preview --port 4180",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "sim": "tsx tests/sim/run-sim.ts",
    "audit": "node scripts/retail-audit.mjs",
    "audit:design": "node scripts/design-audit.mjs",
    "audit:behaviour": "node scripts/design-behaviour.mjs",
    "audit:interaction": "node scripts/design-interaction.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.0",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
